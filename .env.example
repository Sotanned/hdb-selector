# Everything below is OPTIONAL. Without any of it the app still runs: address
# search, HDB resale prices, HDB block information and NEA readings are all
# open endpoints. The credentials below unlock the datasets that `npm run seed`
# downloads, plus real walking routes.

# OneMap — free registration at https://www.onemap.gov.sg/apidocs/register
# Used by: the seed script (MRT stations, hawker centres, supermarkets, clinics,
# malls, parks, sports facilities, preschools, dengue clusters), plus real
# walking routes and reverse geocoding in the report.
ONEMAP_EMAIL=
ONEMAP_PASSWORD=

# LTA DataMall — free key at https://datamall.lta.gov.sg/content/datamall/en/request-for-api.html
# Used by: the seed script, for bus stop locations.
LTA_ACCOUNT_KEY=
